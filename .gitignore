# ===== Godot (game/) =====
# Import cache + editor data: regenerated automatically when the project
# is opened in Godot. Source assets and their .import files ARE committed,
# so textures/animations re-import correctly on a fresh clone.
.godot/
/game/android/

# ===== JaCaMo / Gradle (mind/) =====
# Build output and Gradle cache: regenerated by `gradle run`.
/mind/build/
/mind/.gradle/
/mind/bin/

# ===== Logs / local databases =====
*.log
ruvector.db
*.db

# ===== OS / editor cruft =====
.DS_Store
Thumbs.db
desktop.ini
